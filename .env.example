# Copy to .env and adjust. docker-compose reads this file automatically.

# --- Database ---
DB_NAME=lostfound
DB_USER=lostfound
DB_PASSWORD=lostfound
# Host port the Postgres container is published on
DB_PORT=5432

# --- Application ---
APP_PORT=8080

# --- CORS ---
# Browser origins allowed to call the API. Set this to your real host in production.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300

# --- JWT ---
# Required and at least 32 bytes (HS256). Generate e.g. with: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Login throttling ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT=15m
LOGIN_ATTEMPT_WINDOW=15m

# --- Initial admin (optional) ---
# Both values must be set explicitly to create an admin on startup. The password must
# contain at least 12 characters. An existing regular user is never promoted.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
# Set true for one boot to reset an existing ADMIN account's password, then turn it off.
ADMIN_RESET_PASSWORD=false

# --- Firebase Cloud Messaging (optional) ---
# Path (inside the container) to a Firebase service-account JSON file.
# Leave empty to run without push notifications.
# To enable: mount the file into the app container and set the path here.
FIREBASE_CREDENTIALS=
