# Copy to .env and adjust. docker-compose reads this file automatically.

# --- Database ---
DB_NAME=lostfound
DB_USER=lostfound
DB_PASSWORD=lostfound
# Host port the Postgres container is published on
DB_PORT=5432

# --- Application ---
APP_PORT=8080

# --- CORS ---
# Browser origins allowed to call the API. Set this to your real host in production.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300

# --- JWT ---
# MUST be at least 32 characters (HS256). Generate e.g. with: openssl rand -hex 32
JWT_SECRET=change-me-0123456789abcdef0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Default admin ---
# Ensured on startup: created if missing, promoted to ADMIN if it already exists.
# An existing account's password is never overwritten. Leave ADMIN_EMAIL empty to disable.
# CHANGE ADMIN_PASSWORD before deploying anywhere real.
ADMIN_EMAIL=mengheak088@gmail.com
ADMIN_PASSWORD=12345678
ADMIN_NAME=Administrator
# Set true for a single boot to force the admin password back to ADMIN_PASSWORD,
# then set it false again. Useful if you get locked out of the admin account.
ADMIN_RESET_PASSWORD=false

# --- Firebase Cloud Messaging (optional) ---
# Path (inside the container) to a Firebase service-account JSON file.
# Leave empty to run without push notifications.
# To enable: mount the file into the app container and set the path here.
FIREBASE_CREDENTIALS=
